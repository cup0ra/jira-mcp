{
  "name": "@cup0ra/jira-mcp",
  "version": "0.1.1",
  "description": "Compact Jira Server/Data Center MCP server with PAT authentication",
  "type": "module",
  "bin": {
    "jira-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cup0ra/jira-mcp.git"
  },
  "homepage": "https://github.com/cup0ra/jira-mcp#readme",
  "bugs": {
    "url": "https://github.com/cup0ra/jira-mcp/issues"
  },
  "keywords": [
    "mcp",
    "jira",
    "jira-server",
    "jira-data-center",
    "attachments",
    "claude",
    "codex"
